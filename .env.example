# Dueño de la app: tu correo de Google. Siempre tiene acceso y invita a los demás desde Ajustes -> Invitados.
OWNER_EMAIL=
TIMEZONE=America/Argentina/San_Juan
# En Vercel: cadena del Transaction pooler de Supabase (puerto 6543).
DATABASE_URL=sqlite:///./data/horas.db
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-3.5-flash-lite responde en 1-3 s; gemini-3.5-flash es mas capaz pero puede tardar 10-30 s.
GEMINI_MODEL=gemini-3.5-flash-lite
# El ingreso a la app es con Google: estas variables son obligatorias (README, seccion 3).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback
FRONTEND_URL=http://localhost:8000
