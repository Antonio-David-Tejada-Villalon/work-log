# Copiá este archivo como .env y completá los valores.
APP_PIN=1234                       # PIN para proteger la app (recomendado)
TIMEZONE=America/Argentina/San_Juan
DATABASE_URL=sqlite:///./data/horas.db   # En Vercel: Transaction pooler de Supabase (puerto 6543)
GEMINI_API_KEY=                    # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.5-flash-lite   # rápido (1-3 s). gemini-3.5-flash es más capaz pero puede tardar 10-30 s
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback
FRONTEND_URL=http://localhost:5173
